---
const photos = [
  { id: 'drums', alt: 'Drummer mid-stroke at the studio kit.' },
  { id: 'bass', alt: 'Bassist in headphones looking down at his strings.' },
  { id: 'vocals', alt: 'Vocalist listening through headphones at the microphone.' },
  { id: 'guitar', alt: 'Guitarist in a baseball cap holding a black Greco.' },
  { id: 'piano', alt: 'Pianist reflected in the open lid of the grand piano.' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#191816" />
    <meta name="description" content="Noralights at Pannonia Studio. Album coming soon." />
    <title>Noralights — Album Coming Soon</title>
  </head>
  <body>
    <main class="cover" aria-labelledby="band">
      <div class="montage" role="group" aria-label="The band at Pannonia Studio">
        {photos.map(({ id, alt }) => (
          <div class:list={['tile', id]}>
            <img src={'/images/' + id + '.webp'} alt={alt} fetchpriority={id === 'vocals' ? 'high' : 'auto'} />
          </div>
        ))}
      </div>
      <header class="caption">
        <h1 id="band">NORALIGHTS</h1>
        <div class="release">
          <p>ALBUM COMING SOON</p>
          <p>PANNONIA &nbsp;/&nbsp; 2026</p>
        </div>
      </header>
    </main>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html), :global(body) { margin: 0; background: #191816; color: #f5efdc; }
  .cover {
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    min-height: max(32vw, 100svh);
    overflow: hidden;
  }
  .montage {
    position: relative;
    display: grid;
    grid-template: "drums vocals guitar" 1fr "bass vocals piano" 1fr / 590fr 608fr 590fr;
    gap: clamp(3px, .333vw, 7px);
    overflow: hidden;
  }
  .tile { position: relative; overflow: hidden; min-width: 0; }
  .tile img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .drums { grid-area: drums; }
  .bass { grid-area: bass; }
  .vocals { grid-area: vocals; }
  .guitar { grid-area: guitar; }
  .piano { grid-area: piano; }
  .caption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 2vw 2.2vw;
    min-height: 14.72vw;
  }
  h1, p { margin: 0; }
  h1 {
    font: 700 11.06vw/.94 "Helvetica Neue", Helvetica, Arial, sans-serif;
    letter-spacing: -.05em;
  }
  .release {
    width: 19.1vw;
    font: 400 clamp(.875rem, 1.33vw, 2rem)/1.4 Menlo, Consolas, monospace;
  }
  .release p:first-child { color: #f0b26f; }
  .release p + p { margin-top: .65em; font-size: .96em; }

  @media (orientation: portrait) {
    .cover { min-height: max(100svh, 124vw); }
    .montage {
      grid-template-areas:
        "drums drums drums vocals vocals vocals"
        "bass  bass  bass  vocals vocals vocals"
        "guitar guitar guitar guitar piano piano";
      grid-template-rows: 1fr 1fr 42vw;
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
    .vocals img { object-position: 55% 45%; }
    .piano img { object-position: 32% center; }
    .caption { display: grid; justify-content: stretch; gap: 1.1rem; padding: 1.25rem 4vw max(1.4rem, env(safe-area-inset-bottom)); }
    h1 { font-size: 14.8vw; }
    .release { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: .45rem 1rem; width: auto; }
    .release p + p { margin: 0; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .tile, h1, .release {
      animation: arrive 900ms cubic-bezier(.2,.75,.22,1) backwards;
    }
    .tile { --dy: 110%; }
    .vocals { --dy: -101%; }
    .bass, .piano { animation-delay: 80ms; }
    h1 { --dx: -110%; animation-delay: 110ms; }
    .release { --dx: calc(100% + 5vw); animation-delay: 160ms; }
    @keyframes arrive {
      from { opacity: 0; transform: translate(var(--dx, 0%), var(--dy, 0%)); }
      to { opacity: 1; transform: translate(0, 0); }
    }
    @media (hover: hover) and (pointer: fine) {
      .tile img { transition: transform 450ms cubic-bezier(.2,.7,.3,1); }
      .tile:hover img { transform: scale(1.045); }
    }
  }
</style>
